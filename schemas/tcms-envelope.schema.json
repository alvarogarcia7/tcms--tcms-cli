{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "tcms-envelope.schema.json",
  "title": "TCMS Envelope Meta-Schema",
  "description": "Meta-schema for TCMS document envelopes requiring type and schema fields",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "test_case",
        "test_execution",
        "test_verification",
        "test_result",
        "container_config",
        "test_results_container",
        "test_case_main",
        "test_plan",
        "test_run",
        "execution_log",
        "verification_result",
        "trace_matrix",
        "baseline",
        "review",
        "action_item",
        "independence_assignment",
        "analysis_report",
        "coverage_report",
        "product",
        "plan_document",
        "requirement",
        "design_element",
        "code_unit",
        "environment",
        "problem_report",
        "change_request",
        "qa_record",
        "objective",
        "audit_trail_entry",
        "integration_config"
      ],
      "description": "Type of TCMS document"
    },
    "schema": {
      "type": "string",
      "pattern": "^tcms/.*\\.schema(\\.v\\d+)?\\.json$",
      "description": "Schema reference: tcms/<name>.schema.v<version>.json (CLI schemas) or tcms/<name>.schema.json (tcms-schemas, pinned in schemas/tcms/TCMS_SCHEMAS_VERSION)"
    }
  },
  "required": [
    "type",
    "schema"
  ]
}
