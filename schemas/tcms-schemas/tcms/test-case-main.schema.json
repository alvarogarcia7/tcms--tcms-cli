{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "requirement": {
      "type": "string"
    },
    "item": {
      "type": "integer"
    },
    "tc": {
      "type": "integer"
    },
    "id": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "general_initial_conditions": {
      "type": "object",
      "description": "Top-level general initial conditions. Values can use BDD patterns (e.g., 'create directory \"/tmp/test\"') that are automatically converted to executable commands, or plain text that becomes comments. See docs/BDD_INITIAL_CONDITIONS.md for pattern reference.",
      "additionalProperties": {
        "type": "array",
        "items": {
          "oneOf": [
            {
              "type": "string",
              "description": "A condition statement. Can be a BDD pattern (e.g., 'create directory \"/path\"', 'set environment variable \"VAR\" to \"value\"', 'wait for 5 seconds') or plain text description."
            },
            {
              "type": "object",
              "properties": {
                "ref": {
                  "type": "string",
                  "description": "Reference to a condition defined elsewhere."
                }
              },
              "required": [
                "ref"
              ]
            },
            {
              "type": "object",
              "properties": {
                "test_sequence": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "integer",
                      "description": "ID of the test sequence to reference."
                    },
                    "step": {
                      "type": "string",
                      "description": "Step identifier within the test sequence."
                    }
                  },
                  "required": [
                    "id",
                    "step"
                  ]
                }
              },
              "required": [
                "test_sequence"
              ]
            }
          ]
        }
      },
      "properties": {
        "include": {
          "type": "array",
          "description": "Array of references to include conditions from other test cases or sequences.",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "ID of the test case to include conditions from."
              },
              "test_sequence": {
                "type": "string",
                "description": "Optional test sequence ID to include conditions from a specific sequence."
              }
            },
            "required": [
              "id"
            ]
          }
        }
      }
    },
    "initial_conditions": {
      "type": "object",
      "description": "Top-level initial conditions specific to devices/systems. Values can use BDD patterns (e.g., 'file \"/path\" should exist', 'restart service \"nginx\"') that are automatically converted to executable commands, or plain text that becomes comments. See docs/BDD_INITIAL_CONDITIONS.md for pattern reference.",
      "additionalProperties": {
        "type": "array",
        "items": {
          "oneOf": [
            {
              "type": "string",
              "description": "A condition statement. Can be a BDD pattern (e.g., 'ping device \"192.168.1.1\" with 3 retries', 'port 80 on \"localhost\" should be open') or plain text description."
            },
            {
              "type": "object",
              "properties": {
                "ref": {
                  "type": "string",
                  "description": "Reference to a condition defined elsewhere."
                }
              },
              "required": [
                "ref"
              ]
            },
            {
              "type": "object",
              "properties": {
                "test_sequence": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "integer",
                      "description": "ID of the test sequence to reference."
                    },
                    "step": {
                      "type": "string",
                      "description": "Step identifier within the test sequence."
                    }
                  },
                  "required": [
                    "id",
                    "step"
                  ]
                }
              },
              "required": [
                "test_sequence"
              ]
            }
          ]
        }
      },
      "properties": {
        "include": {
          "type": "array",
          "description": "Array of references to include conditions from other test cases or sequences.",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "ID of the test case to include conditions from."
              },
              "test_sequence": {
                "type": "string",
                "description": "Optional test sequence ID to include conditions from a specific sequence."
              }
            },
            "required": [
              "id"
            ]
          }
        }
      }
    },
    "test_sequences": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "initial_conditions": {
            "type": "object",
            "description": "Sequence-level initial conditions. Values can use BDD patterns (e.g., 'wait until file \"/tmp/ready\" exists with timeout 30 seconds') that are automatically converted to executable commands, or plain text that becomes comments. See docs/BDD_INITIAL_CONDITIONS.md for pattern reference.",
            "additionalProperties": {
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "type": "string",
                    "description": "A condition statement. Can be a BDD pattern or plain text description."
                  },
                  {
                    "type": "object",
                    "properties": {
                      "ref": {
                        "type": "string",
                        "description": "Reference to a condition defined elsewhere."
                      }
                    },
                    "required": [
                      "ref"
                    ]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "test_sequence": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "integer",
                            "description": "ID of the test sequence to reference."
                          },
                          "step": {
                            "type": "string",
                            "description": "Step identifier within the test sequence."
                          }
                        },
                        "required": [
                          "id",
                          "step"
                        ]
                      }
                    },
                    "required": [
                      "test_sequence"
                    ]
                  }
                ]
              }
            },
            "properties": {
              "include": {
                "type": "array",
                "description": "Array of references to include conditions from other test cases or sequences.",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "ID of the test case to include conditions from."
                    },
                    "test_sequence": {
                      "type": "string",
                      "description": "Optional test sequence ID to include conditions from a specific sequence."
                    }
                  },
                  "required": [
                    "id"
                  ]
                }
              }
            }
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "step": {
                  "type": "integer"
                },
                "manual": {
                  "type": "boolean"
                },
                "description": {
                  "type": "string"
                },
                "command": {
                  "type": [
                    "string",
                    "boolean"
                  ]
                },
                "expected": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "result": {
                      "type": [
                        "string",
                        "integer"
                      ]
                    },
                    "output": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "result",
                    "output"
                  ]
                },
                "verification": {
                  "type": "object",
                  "properties": {
                    "result": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "boolean"
                        },
                        {
                          "type": "object",
                          "properties": {
                            "condition": {
                              "type": "string"
                            },
                            "if_true": {
                              "type": "array",
                              "items": {
                                "type": "string"
                              }
                            },
                            "if_false": {
                              "type": "array",
                              "items": {
                                "type": "string"
                              }
                            },
                            "always": {
                              "type": "array",
                              "items": {
                                "type": "string"
                              }
                            }
                          },
                          "required": [
                            "condition"
                          ]
                        }
                      ]
                    },
                    "output": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "boolean"
                        },
                        {
                          "type": "object",
                          "properties": {
                            "condition": {
                              "type": "string"
                            },
                            "if_true": {
                              "type": "array",
                              "items": {
                                "type": "string"
                              }
                            },
                            "if_false": {
                              "type": "array",
                              "items": {
                                "type": "string"
                              }
                            },
                            "always": {
                              "type": "array",
                              "items": {
                                "type": "string"
                              }
                            }
                          },
                          "required": [
                            "condition"
                          ]
                        }
                      ]
                    },
                    "output_file": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "boolean"
                        },
                        {
                          "type": "object",
                          "properties": {
                            "condition": {
                              "type": "string"
                            },
                            "if_true": {
                              "type": "array",
                              "items": {
                                "type": "string"
                              }
                            },
                            "if_false": {
                              "type": "array",
                              "items": {
                                "type": "string"
                              }
                            },
                            "always": {
                              "type": "array",
                              "items": {
                                "type": "string"
                              }
                            }
                          },
                          "required": [
                            "condition"
                          ]
                        }
                      ]
                    },
                    "general": {
                      "type": "array",
                      "description": "General verification conditions that can be evaluated.",
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string",
                            "description": "Name or description of the verification check."
                          },
                          "condition": {
                            "type": "string",
                            "description": "Condition expression to evaluate for this verification."
                          }
                        },
                        "required": [
                          "name",
                          "condition"
                        ]
                      }
                    }
                  },
                  "required": [
                    "result",
                    "output"
                  ]
                },
                "ref": {
                  "type": "string",
                  "description": "Optional reference identifier for this step."
                },
                "capture_vars": {
                  "oneOf": [
                    {
                      "type": "array",
                      "description": "Array of capture variable definitions with name and either capture pattern or command.",
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string",
                            "description": "Variable name to capture value into."
                          },
                          "capture": {
                            "type": "string",
                            "description": "Regex pattern for extracting value from COMMAND_OUTPUT."
                          },
                          "command": {
                            "type": "string",
                            "description": "Command to execute to obtain the variable value."
                          }
                        },
                        "required": [
                          "name"
                        ],
                        "oneOf": [
                          {
                            "required": [
                              "capture"
                            ],
                            "not": {
                              "required": [
                                "command"
                              ]
                            }
                          },
                          {
                            "required": [
                              "command"
                            ],
                            "not": {
                              "required": [
                                "capture"
                              ]
                            }
                          }
                        ]
                      }
                    },
                    {
                      "type": "object",
                      "description": "Legacy format: Variable names as keys with regex patterns as values for extracting values from COMMAND_OUTPUT.",
                      "additionalProperties": {
                        "type": "string"
                      }
                    }
                  ]
                }
              },
              "required": [
                "step",
                "description",
                "command",
                "expected"
              ]
            }
          },
          "ref": {
            "type": "string",
            "description": "Optional reference identifier for this test sequence."
          },
          "variables": {
            "type": "object",
            "description": "Sequence-scoped variables that can be declared and used throughout the test sequence.",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "initial_conditions",
          "steps"
        ]
      }
    },
    "requirements": {
      "type": "array",
      "description": "Requirement IDs (HLR/LLR, owned by the requirements tool) this test case verifies. Traceability and coverage use this list only; the legacy required 'requirement' field is kept for compatibility and is not used for coverage.",
      "items": {
        "type": "string"
      }
    },
    "test_type": {
      "type": "string",
      "description": "Normal-range tests exercise inputs the software should handle; robustness tests exercise abnormal inputs and conditions; security tests exercise attacks and misuse.",
      "enum": [
        "normal_range",
        "robustness",
        "security"
      ]
    },
    "test_category": {
      "type": "string",
      "description": "Technique used to select inputs. Normal range: equivalence_class, boundary_value, state_transition. Robustness: invalid_value, out_of_range, failure_mode, overflow, timing_fault. Security: fuzzing, penetration, misuse_case, vulnerability_scan. The pairing is enforced when both fields are present.",
      "enum": [
        "equivalence_class",
        "boundary_value",
        "state_transition",
        "invalid_value",
        "out_of_range",
        "failure_mode",
        "overflow",
        "timing_fault",
        "fuzzing",
        "penetration",
        "misuse_case",
        "vulnerability_scan"
      ]
    },
    "level": {
      "type": "string",
      "description": "Test level: hw_sw_integration (HLR-based, on target), sw_integration (HLR/LLR interaction, data and control coupling), low_level (LLR-based) or validation (system-level, built the right thing). Tests are requirements-based at every level; the requirements verified are listed in 'requirements'.",
      "enum": [
        "hw_sw_integration",
        "sw_integration",
        "low_level",
        "validation"
      ]
    },
    "objective": {
      "type": "string",
      "description": "The single objective this test case demonstrates (inputs, conditions and expected results serve one objective)."
    },
    "version": {
      "type": "string",
      "description": "Test case version; runs and results record which version they executed"
    },
    "status": {
      "type": "string",
      "description": "Life-cycle status; changes are gated by reviews",
      "enum": [
        "draft",
        "in_review",
        "approved",
        "obsolete"
      ]
    },
    "environment": {
      "type": "string",
      "description": "Test environment required to run the procedure (target, simulator, tool versions)."
    },
    "pass_fail_criteria": {
      "type": "string",
      "description": "Procedure-level pass/fail criteria, in addition to per-step 'expected'."
    },
    "author": {
      "type": "string",
      "description": "Person who wrote the test case. Used by independence checks: the reviewer of this test case and of its results must not be the author when independence_required is true."
    },
    "independence_required": {
      "type": "boolean",
      "description": "True if the review of this test case and of its results must be done by someone other than 'author' (see independence-assignment and test-run.reviewer)."
    },
    "external_refs": {
      "type": "array",
      "description": "Jira Test / Xray Test / Zephyr test case created for this test case",
      "items": {
        "type": "object",
        "properties": {
          "system": {
            "type": "string",
            "description": "External system",
            "enum": [
              "jira",
              "xray",
              "zephyr_scale",
              "zephyr_squad",
              "strictdoc",
              "gitlab",
              "other"
            ]
          },
          "key": {
            "type": "string",
            "description": "Identifier in that system (Jira issue key, Xray test key, Zephyr key, StrictDoc UID, Fix Version id)"
          },
          "url": {
            "type": "string",
            "description": "Resolved URL; the resolver derives it from integration-config when absent",
            "format": "uri"
          },
          "synced_at": {
            "type": "string",
            "description": "Last successful sync of this record to that system",
            "format": "date-time"
          }
        },
        "required": [
          "system",
          "key"
        ]
      }
    },
    "hooks": {
      "type": "object",
      "description": "Optional hooks for custom script execution at various points in the test lifecycle. Hook paths are relative to the test case YAML file location or absolute paths.",
      "properties": {
        "script_start": {
          "oneOf": [
            {
              "type": "string",
              "description": "Path to script executed once at the very beginning of the test case script."
            },
            {
              "type": "object",
              "properties": {
                "command": {
                  "type": "string",
                  "description": "Path to script executed once at the very beginning of the test case script."
                },
                "on_error": {
                  "type": "string",
                  "enum": [
                    "fail",
                    "continue"
                  ],
                  "default": "fail",
                  "description": "Behavior when this hook fails."
                }
              },
              "required": [
                "command"
              ]
            }
          ]
        },
        "setup_test": {
          "oneOf": [
            {
              "type": "string",
              "description": "Path to script executed once at test case setup."
            },
            {
              "type": "object",
              "properties": {
                "command": {
                  "type": "string",
                  "description": "Path to script executed once at test case setup."
                },
                "on_error": {
                  "type": "string",
                  "enum": [
                    "fail",
                    "continue"
                  ],
                  "default": "fail",
                  "description": "Behavior when this hook fails."
                }
              },
              "required": [
                "command"
              ]
            }
          ]
        },
        "before_sequence": {
          "oneOf": [
            {
              "type": "string",
              "description": "Path to script executed before each test sequence starts."
            },
            {
              "type": "object",
              "description": "Hook executed before each test sequence starts.",
              "properties": {
                "command": {
                  "type": "string",
                  "description": "Path to script executed before each test sequence starts."
                },
                "on_error": {
                  "type": "string",
                  "enum": [
                    "fail",
                    "continue"
                  ],
                  "default": "fail",
                  "description": "Behavior when this hook fails."
                }
              },
              "required": [
                "command"
              ]
            }
          ]
        },
        "after_sequence": {
          "oneOf": [
            {
              "type": "string",
              "description": "Path to script executed after each test sequence completes."
            },
            {
              "type": "object",
              "description": "Hook executed after each test sequence completes.",
              "properties": {
                "command": {
                  "type": "string",
                  "description": "Path to script executed after each test sequence completes."
                },
                "on_error": {
                  "type": "string",
                  "enum": [
                    "fail",
                    "continue"
                  ],
                  "default": "fail",
                  "description": "Behavior when this hook fails."
                }
              },
              "required": [
                "command"
              ]
            }
          ]
        },
        "before_step": {
          "oneOf": [
            {
              "type": "string",
              "description": "Path to script executed before each test step."
            },
            {
              "type": "object",
              "description": "Hook executed before each test step.",
              "properties": {
                "command": {
                  "type": "string",
                  "description": "Path to script executed before each test step."
                },
                "on_error": {
                  "type": "string",
                  "enum": [
                    "fail",
                    "continue"
                  ],
                  "default": "fail",
                  "description": "Behavior when this hook fails."
                }
              },
              "required": [
                "command"
              ]
            }
          ]
        },
        "after_step": {
          "oneOf": [
            {
              "type": "string",
              "description": "Path to script executed after each test step."
            },
            {
              "type": "object",
              "description": "Hook executed after each test step.",
              "properties": {
                "command": {
                  "type": "string",
                  "description": "Path to script executed after each test step."
                },
                "on_error": {
                  "type": "string",
                  "enum": [
                    "fail",
                    "continue"
                  ],
                  "default": "fail",
                  "description": "Behavior when this hook fails."
                }
              },
              "required": [
                "command"
              ]
            }
          ]
        },
        "teardown_test": {
          "oneOf": [
            {
              "type": "string",
              "description": "Path to script executed once at test case teardown."
            },
            {
              "type": "object",
              "description": "Hook executed once at test case teardown, after all test sequences complete but before script_end.",
              "properties": {
                "command": {
                  "type": "string",
                  "description": "Path to script executed once at test case teardown."
                },
                "on_error": {
                  "type": "string",
                  "enum": [
                    "fail",
                    "continue"
                  ],
                  "default": "fail",
                  "description": "Behavior when this hook fails."
                }
              },
              "required": [
                "command"
              ]
            }
          ]
        },
        "script_end": {
          "oneOf": [
            {
              "type": "string",
              "description": "Path to script executed once at the very end of the test case script."
            },
            {
              "type": "object",
              "description": "Hook executed once at the very end of the test case script, after all other processing.",
              "properties": {
                "command": {
                  "type": "string",
                  "description": "Path to script executed once at the very end of the test case script."
                },
                "on_error": {
                  "type": "string",
                  "enum": [
                    "fail",
                    "continue"
                  ],
                  "default": "fail",
                  "description": "Behavior when this hook fails."
                }
              },
              "required": [
                "command"
              ]
            }
          ]
        },
        "on_error": {
          "type": "string",
          "enum": [
            "fail",
            "continue"
          ],
          "default": "fail",
          "description": "Global default behavior when a hook script fails (can be overridden per-hook)."
        }
      }
    },
    "hydration_vars": {
      "type": "object",
      "description": "Environment variables that need hydration. Each key is the variable name, and the value is an object with metadata.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of the environment variable."
          },
          "description": {
            "type": "string",
            "description": "Description of the environment variable."
          },
          "default_value": {
            "type": "string",
            "description": "Default value for the environment variable."
          },
          "required": {
            "type": "boolean",
            "description": "Whether this environment variable is required.",
            "default": false
          }
        },
        "required": [
          "name"
        ]
      }
    },
    "prerequisites": {
      "type": "array",
      "description": "Optional list of prerequisites that must be satisfied before running this test case.",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "manual",
              "automatic"
            ],
            "description": "Type of prerequisite: 'manual' requires human verification, 'automatic' can be verified programmatically."
          },
          "description": {
            "type": "string",
            "description": "Description of the prerequisite."
          },
          "verification_command": {
            "type": "string",
            "description": "Command to verify the prerequisite (required for automatic type)."
          }
        },
        "required": [
          "type",
          "description"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "automatic"
                }
              }
            },
            "then": {
              "required": [
                "verification_command"
              ]
            }
          }
        ]
      }
    }
  },
  "required": [
    "requirement",
    "item",
    "tc",
    "id",
    "description",
    "general_initial_conditions",
    "initial_conditions",
    "test_sequences"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "test_type": {
            "const": "normal_range"
          }
        },
        "required": [
          "test_type",
          "test_category"
        ]
      },
      "then": {
        "properties": {
          "test_category": {
            "enum": [
              "equivalence_class",
              "boundary_value",
              "state_transition"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "test_type": {
