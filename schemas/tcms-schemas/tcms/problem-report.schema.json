{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Problem Report",
  "description": "A reported deficiency in any item, raised from executions, reviews, analyses or audits; linked to change requests and regression runs. Field set is a best effort pending the Part 8 definition",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "critical",
        "major",
        "minor",
        "cosmetic"
      ]
    },
    "category": {
      "type": "string",
      "description": "Kind of item at fault",
      "enum": [
        "requirement",
        "design",
        "code",
        "test",
        "tool",
        "process",
        "documentation",
        "other"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "analysed",
        "in_work",
        "fixed",
        "verified",
        "closed",
        "rejected",
        "deferred"
      ]
    },
    "raised_by": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "affected_items": {
      "type": "array",
      "description": "Items affected",
      "items": {
        "type": "object",
        "description": "Reference to any TCMS record",
        "properties": {
          "entity_type": {
            "type": "string",
            "description": "Schema name of the referenced record",
            "enum": [
              "product",
              "plan-document",
              "requirement",
              "design-element",
              "code-unit",
              "test-case",
              "test-plan",
              "baseline",
              "environment",
              "test-run",
              "verification-result",
              "execution-log",
              "coverage-report",
              "review",
              "action-item",
              "problem-report",
              "change-request",
              "qa-record",
              "objective",
              "independence-assignment",
              "analysis-report",
              "trace-matrix"
            ]
          },
          "entity_id": {
            "type": "string",
            "description": "ID of the referenced record"
          },
          "version": {
            "type": "string",
            "description": "Version of the referenced record, when versioned"
          }
        },
        "required": [
          "entity_type",
          "entity_id"
        ]
      }
    },
    "run_id": {
      "type": "string",
      "description": "Test run that revealed it"
    },
    "test_case_id": {
      "type": "string",
      "description": "Test case that revealed it"
    },
    "change_request_ids": {
      "type": "array",
      "description": "Change requests raised to fix it",
      "items": {
        "type": "string"
      }
    },
    "regression_run_ids": {
      "type": "array",
      "description": "Runs that verified the fix",
      "items": {
        "type": "string"
      }
    },
    "resolution": {
      "type": "string"
    },
    "closed_date": {
      "type": "string",
      "format": "date"
    },
    "external_refs": {
      "type": "array",
      "description": "Jira issue (Bug) created or linked for this problem report",
      "items": {
        "type": "object",
        "properties": {
          "system": {
            "type": "string",
            "description": "External system",
            "enum": [
              "jira",
              "xray",
              "zephyr_scale",
              "zephyr_squad",
              "strictdoc",
              "gitlab",
              "other"
            ]
          },
          "key": {
            "type": "string",
            "description": "Identifier in that system (Jira issue key, Xray test key, Zephyr key, StrictDoc UID, Fix Version id)"
          },
          "url": {
            "type": "string",
            "description": "Resolved URL; the resolver derives it from integration-config when absent",
            "format": "uri"
          },
          "synced_at": {
            "type": "string",
            "description": "Last successful sync of this record to that system",
            "format": "date-time"
          }
        },
        "required": [
          "system",
          "key"
        ]
      }
    }
  },
  "required": [
    "id",
    "title",
    "status",
    "raised_by",
    "date"
  ]
}
