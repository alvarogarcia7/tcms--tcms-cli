{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Test Execution Log Entry",
  "description": "Schema for test execution log entries",
  "type": "object",
  "properties": {
    "test_sequence": {
      "type": "integer",
      "description": "Sequence number of the test"
    },
    "step": {
      "type": "integer",
      "description": "Step number within the test sequence"
    },
    "command": {
      "type": "string",
      "description": "The command that was executed"
    },
    "exit_code": {
      "type": "integer",
      "description": "Exit code of the command execution"
    },
    "output": {
      "type": "string",
      "description": "Output from the command execution"
    },
    "timestamp": {
      "type": "string",
      "description": "Timestamp of the execution (optional)"
    },
    "run_id": {
      "type": "string",
      "description": "ID of the test run (see test-run schema) this entry belongs to"
    },
    "test_case_id": {
      "type": "string",
      "description": "ID of the test case being executed"
    },
    "hook_type": {
      "type": "string",
      "description": "Type of hook execution (optional)",
      "enum": [
        "script_start",
        "setup_test",
        "before_sequence",
        "after_sequence",
        "before_step",
        "after_step",
        "teardown_test",
        "script_end"
      ]
    },
    "result_verification_pass": {
      "type": "boolean",
      "description": "Whether result verification passed"
    },
    "output_verification_pass": {
      "type": "boolean",
      "description": "Whether output verification passed"
    },
    "source_yaml_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 of the test case YAML the script was generated from (verifier --verify-source-hash, audit-verifier)"
    }
  },
  "required": [
    "test_sequence",
    "step",
    "command",
    "exit_code",
    "output"
  ]
}
